        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-16" value="main" style="swimlane;whiteSpace=wrap;html=1;swimlaneFillColor=none;rounded=1;glass=0;shadow=1;container=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="360" y="25" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-31" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;main is used to initialize the pararmeters of an ns3 sim_round. This is achieved with the use of a flwr-interface instance. Subsequently it&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;starts a communication round simulation and returns the results to Flower&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;align=center;container=1;" parent="nm4fWMabEApBUTIsR-SC-16" vertex="1">
          <mxGeometry x="7.5" y="30" width="255" height="100" as="geometry">
            <mxRectangle x="5" y="30" width="350" height="50" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-17" value="fl-experiment" style="swimlane;whiteSpace=wrap;html=1;startSize=23;rounded=1;glass=0;shadow=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="395" y="220" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-39" value="fl-experiment generates and manages the simulation environment. In this module the network parameters setup is conducted along with the client positioning (Topology definition).It also collects and formats the simulation round results after a complete experiment execution" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;" parent="nm4fWMabEApBUTIsR-SC-17" vertex="1">
          <mxGeometry x="5" y="30" width="185" height="160" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" source="nm4fWMabEApBUTIsR-SC-18" target="nm4fWMabEApBUTIsR-SC-16" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-18" value="flwr-interface" style="swimlane;whiteSpace=wrap;html=1;rounded=1;glass=0;shadow=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="720" y="30" width="170" height="130" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-34" value="flwr-interface is used to handle the TCP Socket communcation between the Flower and NS3. It manages connections and read-write operations" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;align=center;" parent="nm4fWMabEApBUTIsR-SC-18" vertex="1">
          <mxGeometry x="7" y="30" width="156" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="nm4fWMabEApBUTIsR-SC-19" target="nm4fWMabEApBUTIsR-SC-22" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="70" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-78" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="nm4fWMabEApBUTIsR-SC-19" target="nm4fWMabEApBUTIsR-SC-17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-19" value="fl-server-helper" style="swimlane;whiteSpace=wrap;html=1;rounded=1;glass=0;shadow=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="100" y="227.5" width="200" height="185" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-49" value="It is used to facilitate the creation of a server instance that functions as an ns3::PacketSinkApplication.&lt;div&gt;The undelying logic here is using the factory design pattern with with the module creating a server instance in the backend and the user assinging with setter functions its parameters.&amp;nbsp;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;" parent="nm4fWMabEApBUTIsR-SC-19" vertex="1">
          <mxGeometry x="7.5" y="30" width="185" height="150" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="nm4fWMabEApBUTIsR-SC-20" target="nm4fWMabEApBUTIsR-SC-17" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-20" value="fl-client-session" style="swimlane;whiteSpace=wrap;html=1;startSize=23;rounded=1;glass=0;shadow=1;fillColor=#bac8d3;strokeColor=#23445d;" parent="1" vertex="1">
          <mxGeometry x="720" y="247.5" width="190" height="145" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-45" value="client-session is used to store important information for clients participating in a round. These inforamtion include: the client&#39;s position, its max achievable datarate, and its Id to be able to map his results." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;" parent="nm4fWMabEApBUTIsR-SC-20" vertex="1">
          <mxGeometry x="8.75" y="32.5" width="171.25" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="nm4fWMabEApBUTIsR-SC-22" target="nm4fWMabEApBUTIsR-SC-55" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="345" y="770" />
              <mxPoint x="640" y="770" />
