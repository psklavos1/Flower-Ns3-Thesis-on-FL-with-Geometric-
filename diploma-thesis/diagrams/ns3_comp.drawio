          </mxGeometry>
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-22" value="fl-server" style="swimlane;whiteSpace=wrap;html=1;rounded=1;glass=0;shadow=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="230" y="475" width="230" height="235" as="geometry" />
        </mxCell>
        <mxCell id="nm4fWMabEApBUTIsR-SC-54" value="fl-server represents the federated learning server, while in actuality being a packet sink. It contains a data structure to track connected clients sessionData-namely the sent and received data from a client, his address and more. The module also contains the necessaty methods for socket communcation (read and wirte), to conduct the communication with the virtual clients participating in this round&#39;s simulation." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;" parent="nm4fWMabEApBUTIsR-SC-22" vertex="1">
          <mxGeometry x="7.5" y="25" width="192.5" height="195" as="geometry" />
        </mxCell>
