  shorttitle = {Distributed {{Learning}} in {{Wireless Networks}}},
  author = {Chen, Mingzhe and G{\"u}nd{\"u}z, Deniz and Huang, Kaibin and Saad, Walid and Bennis, Mehdi and Feljan, Aneta Vulgarakis and Poor, H. Vincent},
  year = {2021},
