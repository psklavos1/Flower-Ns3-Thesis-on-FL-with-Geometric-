}

@article{bishopNeuralNetworksTheir1994,
  title = {Neural Networks and Their Applications},
  author = {Bishop, Chris M.},
  year = {1994},
  month = jun,
  journal = {Review of Scientific Instruments},
  volume = {65},
  number = {6},
  pages = {1803--1832},
  issn = {0034-6748},
  doi = {10.1063/1.1144830},
