{
    "configurations": [
        {
            "name": "WSL", // Consider renaming this to something more reflective of the WSL/Linux environment
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64", // Updated to reflect the Linux environment
            "configurationProvider": "ms-vscode.makefile-tools"
        }
    ],
    "version": 4
}
